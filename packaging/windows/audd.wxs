<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer for audd (WiX Toolset v5). Installs audd.exe for the
  current user into %LOCALAPPDATA%\Programs\AudD CLI and adds that folder to
  the user's PATH, so no administrator rights are needed. A newer MSI
  replaces an older one; uninstalling removes the file and the PATH entry.
  Run by hand, it shows the license, then a last page saying audd is
  installed, with a box to open it; silent installs (/qn) show nothing.

  Built by scripts/build-msi.ps1:
    wix build packaging/windows/audd.wxs -arch x64|arm64
      -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d Exe=path\to\audd.exe -d LicenseRtf=license.rtf -o audd.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="AudD CLI"
      Manufacturer="AudD, LLC"
      Version="$(Version)"
      UpgradeCode="c62dffe9-5de7-4511-9a24-091d8b9685a8"
      Scope="perUser"
      Compressed="yes"
      Language="1033">

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of AudD CLI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AudDMusic/audd-cli" />
    <Property Id="ARPHELPLINK" Value="https://github.com/AudDMusic/audd-cli/issues" />

    <!-- License page, progress, and a last page that says audd is installed. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
        Value="AudD CLI is installed. Open a new terminal and run audd to get started." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open AudD CLI now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AuddExeFile]" />
    <CustomAction Id="OpenAudd" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenAudd"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AudD CLI" />
      </Directory>
    </StandardDirectory>

    <!-- Files under the user profile need a registry key as their key path. -->
    <Component Id="AuddExe" Directory="INSTALLFOLDER" Guid="67cb8d49-4686-4e8f-873f-57496028dc2f">
      <RegistryValue Root="HKCU" Key="Software\AudD\CLI" Name="InstallDir"
          Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <File Id="AuddExeFile" Name="audd.exe" Source="$(Exe)" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]"
          Part="last" Action="set" System="no" Permanent="no" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <!-- Removed only when empty. -->
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>
  </Package>
</Wix>
