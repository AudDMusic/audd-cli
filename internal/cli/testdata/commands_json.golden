{"schema_version":1,"version":"VERSION","global_flags":[{"name":"debug","type":"bool","usage":"log HTTP requests to stderr (tokens redacted)"},{"name":"fields","type":"stringSlice","usage":"only output these fields (comma-separated, dotted for nested: result.artist)"},{"name":"format","type":"string","usage":"output format: table, json, jsonl, or csv (default: table on a terminal, JSON when piped)"},{"name":"max-requests","type":"int","default":"0","usage":"stop before spending more than N API requests (0: use the config default)"},{"name":"no-color","type":"bool","usage":"disable colors"},{"name":"profile","type":"string","usage":"profile to use (default: AUDD_PROFILE or the active profile)"},{"name":"quiet","shorthand":"q","type":"bool","usage":"hide notes and progress; in table output, print only the essential line"},{"name":"token","type":"string","usage":"AudD API token (default: AUDD_API_TOKEN, then audd config, then audd login)"},{"name":"yes","shorthand":"y","type":"bool","usage":"answer yes to confirmations (required for billable runs without a terminal)"}],"commands":[{"path":"audd account","summary":"Show your AudD account, plan, and subscription","usage":"audd account","runnable":true,"examples":["audd account","audd account --format json"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd agent-setup","summary":"Teach your coding agent to use audd","usage":"audd agent-setup [flags]","runnable":true,"flags":[{"name":"agents-md","type":"bool","usage":"write an audd section in AGENTS.md"},{"name":"claude","type":"bool","usage":"write a Claude Code skill (.claude/skills/audd/SKILL.md)"},{"name":"codex","type":"bool","usage":"write an audd section in AGENTS.md"},{"name":"cursor","type":"bool","usage":"write a Cursor rule (.cursor/rules/audd.mdc)"},{"name":"dir","type":"string","usage":"project folder to write into (default: the current folder)"},{"name":"print","type":"bool","usage":"print the instructions instead of writing files"}],"examples":["audd agent-setup","audd agent-setup --claude","audd agent-setup --cursor --agents-md","audd agent-setup --claude --print"],"output":"object","exit_codes":[0,1,2]},{"path":"audd api","summary":"Call any AudD API method directly","usage":"audd api <method> [key=value...]","runnable":true,"examples":["audd api getStreams","audd api getCallbackUrl","audd api recognize url=https://audd.tech/example.mp3 return=spotify"],"output":"api_response","exit_codes":[0,1,2,3,4,5]},{"path":"audd auth","summary":"Sign in, sign out, and switch profiles","usage":"audd auth","runnable":false,"examples":["audd auth login","audd auth status","audd auth login --profile work","audd auth switch work","audd auth logout --all"]},{"path":"audd auth login","summary":"Sign in to your AudD account","usage":"audd auth login [flags]","runnable":true,"flags":[{"name":"browser","type":"bool","usage":"sign in with a browser (on this machine, or paste the address back)"},{"name":"complete","type":"string","usage":"finish a waiting browser sign-in with the address the browser was sent to"},{"name":"device","type":"bool","usage":"sign in with a code on any device"},{"name":"no-browser","type":"bool","usage":"do not open a browser on this machine (the URL is printed either way)"},{"name":"scopes","type":"stringSlice","usage":"more permissions to ask for, comma-separated (the default already includes every permission audd uses)"}],"examples":["audd login","audd login --device","audd login --browser","audd login --profile work","audd auth login --complete 'http://127.0.0.1:53682/callback?code=…&state=…'"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd auth logout","summary":"Sign out and remove the saved sign-in","usage":"audd auth logout [flags]","runnable":true,"flags":[{"name":"all","type":"bool","usage":"sign out of every profile"}],"examples":["audd logout","audd auth logout --profile work","audd auth logout --all"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd auth refresh","summary":"Renew the sign-in, or approve extra permissions","usage":"audd auth refresh [flags]","runnable":true,"flags":[{"name":"browser","type":"bool","usage":"approve in a browser"},{"name":"device","type":"bool","usage":"approve with a code on any device"},{"name":"scopes","type":"stringSlice","usage":"permissions to add, such as billing:pay or token:write (comma-separated)"}],"examples":["audd auth refresh","audd auth refresh --scopes billing:pay","audd auth refresh --scopes token:write --device"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd auth status","summary":"Show the signed-in account and which API token is in use","usage":"audd auth status","runnable":true,"examples":["audd auth status","audd whoami --format json"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd auth switch","summary":"Make another profile the default","usage":"audd auth switch <profile>","runnable":true,"examples":["audd auth switch work"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd billing","summary":"Show plans and payments, and get payment links","usage":"audd billing","runnable":false,"examples":["audd billing plans","audd billing history","audd billing owed","audd billing subscribe startup_plan --open","audd billing buy 10000"]},{"path":"audd billing buy","summary":"Get a payment link for extra requests (multiples of 1,000)","usage":"audd billing buy <requests> [flags]","runnable":true,"flags":[{"name":"open","type":"bool","usage":"open the payment link in the browser"}],"examples":["audd billing buy 10000"],"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd billing history","summary":"Show recent payments","usage":"audd billing history","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd billing owed","summary":"Show over-allowance usage due at the next renewal","usage":"audd billing owed","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd billing plans","summary":"List the available plans","usage":"audd billing plans","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd billing renew","summary":"Get a payment link to renew the subscription, including any owed usage","usage":"audd billing renew [flags]","runnable":true,"flags":[{"name":"open","type":"bool","usage":"open the payment link in the browser"}],"examples":["audd billing renew --open"],"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd billing subscribe","summary":"Get a payment link to subscribe to or switch to a plan","usage":"audd billing subscribe <plan> [flags]","runnable":true,"flags":[{"name":"open","type":"bool","usage":"open the payment link in the browser"}],"examples":["audd billing subscribe startup_plan","audd billing subscribe pro_plan --open"],"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd browse","summary":"Explore recognized songs, jobs, streams, and usage","usage":"audd browse [flags]","runnable":true,"flags":[{"name":"tab","type":"string","default":"recent","usage":"tab to open: recent, jobs, streams, usage"}],"examples":["audd browse","audd browse --tab streams","audd browse --tab usage --format json"],"output":"object","exit_codes":[0,1,2]},{"path":"audd cache","summary":"Manage cached recognition results","usage":"audd cache","runnable":false},{"path":"audd cache clear","summary":"Delete every cached result","usage":"audd cache clear","runnable":true,"examples":["audd cache clear"],"output":"object","exit_codes":[0,1,2]},{"path":"audd catalog","summary":"Add songs to your custom catalog","usage":"audd catalog","runnable":false},{"path":"audd catalog add","summary":"Fingerprint a song into your custom catalog","usage":"audd catalog add <file|url> --id N [flags]","runnable":true,"flags":[{"name":"id","type":"int","default":"0","required":true,"usage":"audio_id to store the song under (required)"}],"examples":["audd catalog add song.mp3 --id 42","audd catalog add https://example.com/song.mp3 --id 43 --yes"],"output":"object","exit_codes":[0,1,2,3,4,5,6]},{"path":"audd commands","summary":"List every command; --json for a machine-readable reference","usage":"audd commands [flags]","runnable":true,"flags":[{"name":"json","type":"bool","usage":"print the full reference as JSON"}],"examples":["audd commands","audd commands --json","audd commands --json | jq '.commands[] | select(.path == \"audd recognize\")'"],"output":"commands","exit_codes":[0,1,2]},{"path":"audd completion","summary":"Print a shell completion script","usage":"audd completion bash|zsh|fish|powershell","runnable":true,"exit_codes":[0,1,2]},{"path":"audd config","summary":"Read and change settings","usage":"audd config","runnable":false,"examples":["audd config set token your-api-token","audd config set token - < token.txt","audd config set format json","audd config set streams.background_recorder false","audd config list"]},{"path":"audd config get","summary":"Show one setting","usage":"audd config get <key>","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd config list","summary":"Show all settings","usage":"audd config list","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd config set","summary":"Change a setting","usage":"audd config set <key> <value>","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd config unset","summary":"Remove a setting","usage":"audd config unset <key>","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd docs","summary":"Print AudD documentation as markdown","usage":"audd docs [topic]","runnable":true,"examples":["audd docs","audd docs api","audd docs enterprise > enterprise.md","audd docs cli","audd docs api --format json"],"output":"docs","exit_codes":[0,1,2,5]},{"path":"audd jobs","summary":"List, inspect, and resume batch recognitions","usage":"audd jobs","runnable":false,"examples":["audd jobs list","audd jobs show k7m2xq","audd jobs show k7m2xq --failed","audd jobs resume k7m2xq","audd jobs resume k7m2xq --retry-failed","audd jobs clean --older-than 30d"]},{"path":"audd jobs browse","summary":"Explore a job's results interactively","usage":"audd jobs browse <id>","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd jobs clean","summary":"Delete old jobs from this computer","usage":"audd jobs clean [<id>…] [flags]","runnable":true,"flags":[{"name":"all","type":"bool","usage":"delete every job that is not running"},{"name":"older-than","type":"string","default":"30d","usage":"delete jobs not updated for this long, such as 12h or 7d"}],"examples":["audd jobs clean","audd jobs clean --older-than 7d","audd jobs clean k7m2xq","audd jobs clean --all"],"output":"object","exit_codes":[0,1,2]},{"path":"audd jobs list","aliases":["ls"],"summary":"List jobs, newest first","usage":"audd jobs list","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd jobs resume","summary":"Continue a job where it stopped","usage":"audd jobs resume <id> [flags]","runnable":true,"flags":[{"name":"concurrency","type":"int","default":"0","usage":"parallel requests (default: the concurrency setting, else 4)"},{"name":"dry-run","type":"bool","usage":"show what resuming would send, and stop"},{"name":"retry-failed","type":"bool","usage":"also retry the other failed files, including files whose earlier request may have reached AudD"}],"examples":["audd jobs resume k7m2xq","audd jobs resume k7m2xq --retry-failed --yes","audd jobs resume k7m2xq --max-requests 500"],"output":"recognition","streaming":true,"exit_codes":[0,1,2,3,4,5,6,7,130]},{"path":"audd jobs show","summary":"Show a job and the result of every file","usage":"audd jobs show <id> [flags]","runnable":true,"flags":[{"name":"failed","type":"bool","usage":"show only the files that failed"}],"output":"object","exit_codes":[0,1,2]},{"path":"audd listen","summary":"Identify the music playing near you (microphone)","usage":"audd listen [flags]","runnable":true,"flags":[{"name":"details","shorthand":"v","type":"bool","usage":"show every field"},{"name":"device","type":"string","usage":"input device (default: the system default input)"},{"name":"fail-on-no-match","type":"bool","usage":"exit 1 when the song is not recognized"},{"name":"no-art","type":"bool","usage":"do not show cover art"},{"name":"return","type":"string","usage":"extra metadata: apple_music, spotify, deezer, musicbrainz (comma-separated)"},{"name":"seconds","type":"int","default":"10","usage":"how many seconds to record (at most 60)"}],"examples":["audd listen","audd listen --seconds 12 --return apple_music,spotify","audd listen --device \"Microphone (USB Audio)\"","audd listen --format json"],"output":"recognition","exit_codes":[0,1,2,3,4,5,130]},{"path":"audd login","alias_of":"audd auth login","summary":"Sign in to your AudD account (same as audd auth login)","usage":"audd login [flags]","runnable":true,"flags":[{"name":"browser","type":"bool","usage":"sign in with a browser (on this machine, or paste the address back)"},{"name":"complete","type":"string","usage":"finish a waiting browser sign-in with the address the browser was sent to"},{"name":"device","type":"bool","usage":"sign in with a code on any device"},{"name":"no-browser","type":"bool","usage":"do not open a browser on this machine (the URL is printed either way)"},{"name":"scopes","type":"stringSlice","usage":"more permissions to ask for, comma-separated (the default already includes every permission audd uses)"}],"examples":["audd login","audd login --device","audd login --browser","audd login --profile work","audd auth login --complete 'http://127.0.0.1:53682/callback?code=…&state=…'"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd logout","alias_of":"audd auth logout","summary":"Sign out and remove the saved sign-in (same as audd auth logout)","usage":"audd logout [flags]","runnable":true,"flags":[{"name":"all","type":"bool","usage":"sign out of every profile"}],"examples":["audd logout","audd auth logout --profile work","audd auth logout --all"],"output":"object","exit_codes":[0,1,2,3,5]},{"path":"audd mcp","summary":"Run a local MCP server for AI agents (stdio)","usage":"audd mcp","runnable":true,"examples":["claude mcp add audd -- audd mcp","claude mcp add audd -- audd mcp --max-requests 200"],"exit_codes":[0,1,2,3]},{"path":"audd now-playing","summary":"Show the latest songs on your streams","usage":"audd now-playing [radio-id...] [flags]","runnable":true,"flags":[{"name":"format","type":"string","usage":"template for each line, such as \"{{.Artist}} - {{.Title}}\" (or table, json, jsonl, csv)"},{"name":"no-art","type":"bool","usage":"do not show cover art"},{"name":"notify","type":"bool","usage":"show a desktop notification when the song changes"},{"name":"once","type":"bool","usage":"print the latest song of each stream and exit"},{"name":"timeout","type":"duration","default":"0s","usage":"stop after this long (for example 30m)"}],"examples":["audd now-playing","audd now-playing 3 7","audd now-playing --once","audd now-playing 3 --once --format \"{{.Artist}} - {{.Title}}\"","audd now-playing 3 --format \"{{if .Playing}}▶ {{end}}{{.Artist}} - {{.Title}}\"","audd now-playing --notify","audd now-playing --timeout 1h > plays.jsonl"],"output":"now_playing","exit_codes":[0,1,2,3,5]},{"path":"audd recognize","summary":"Identify music in files, URLs, and folders","usage":"audd recognize <file|url|dir|glob|-> [flags]","runnable":true,"flags":[{"name":"accurate-offsets","type":"bool","default":"true","usage":"with --enterprise: exact start and end offsets for each match"},{"name":"at","type":"string","usage":"send a clip starting at this time, such as 90, 1:30, or 1m30s (needs ffmpeg)"},{"name":"browse","type":"bool","usage":"open the results in the interactive explorer afterwards"},{"name":"concurrency","type":"int","default":"0","usage":"parallel requests for batches (default 4, or audd config concurrency)"},{"name":"details","shorthand":"v","type":"bool","usage":"show every field of the result"},{"name":"dry-run","type":"bool","usage":"show the plan and cost without sending anything"},{"name":"duration","type":"string","usage":"clip length for --at (default 12s)"},{"name":"enterprise","type":"bool","usage":"scan the whole file and return every match with timestamps (billed per 12-second chunk; needs --limit)"},{"name":"every","type":"int","default":"0","usage":"with --enterprise: chunks to scan in a row"},{"name":"fail-on-no-match","type":"bool","usage":"exit 1 when there is no match (in a batch: when any file has no match)"},{"name":"limit","type":"string","required_when":"with --enterprise (N chunks per file, or none)","usage":"with --enterprise: at most N 12-second chunks per file, or none"},{"name":"max-files","type":"string","required_when":"for a batch: a folder, a glob, several arguments, or a list on stdin (N files, or none)","usage":"for folders, globs, and lists: at most N files, or none"},{"name":"new","type":"bool","usage":"for a batch that ran before and did not finish: start over as a new job"},{"name":"no-art","type":"bool","usage":"do not show cover art"},{"name":"no-cache","type":"bool","usage":"send the audio even if the result is cached"},{"name":"resume","type":"bool","usage":"for a batch that ran before and did not finish: continue it"},{"name":"return","type":"string","usage":"extra metadata: apple_music, spotify, deezer, musicbrainz (comma-separated)"},{"name":"skip","type":"int","default":"0","usage":"with --enterprise: chunks to skip after each scanned run"},{"name":"skip-first-seconds","type":"int","default":"0","usage":"with --enterprise: seconds to skip at the start of the file"},{"name":"tracklist","type":"bool","usage":"with --enterprise: merge consecutive matches into tracks with start and end times"},{"name":"use-timecode","type":"bool","usage":"with --enterprise: start at the time in the URL (t=, start=)"}],"examples":["audd recognize song.mp3","audd recognize https://audd.tech/example.mp3 --return apple_music,spotify","audd recognize mix.mp3 --at 1:30","audd recognize mix.mp3 --enterprise --limit 20 --tracklist","audd recognize ./recordings --max-files 200 --dry-run","ls *.mp3 | audd recognize - --max-files 50 --yes"],"output":"recognition","exit_codes":[0,1,2,3,4,5,6,7,130]},{"path":"audd streams","summary":"Manage stream monitoring, watch it live, record it, and report on it","usage":"audd streams","runnable":false,"examples":["audd streams add https://radio.example/stream.mp3 --id 1","audd streams list","audd streams watch","audd streams history --since 24h","audd streams report --by artist --since 30d"]},{"path":"audd streams add","summary":"Add a stream to monitor","usage":"audd streams add <url> --id N [flags]","runnable":true,"flags":[{"name":"id","type":"int","default":"0","required":true,"usage":"the stream's ID (a number you choose)"},{"name":"start","type":"bool","usage":"send each result when a song starts instead of when it ends (live now-playing, no play length)"}],"examples":["audd streams add https://radio.example/stream.mp3 --id 1","audd streams add twitch:somechannel --id 2 --start"],"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd streams callback","summary":"Show or set the URL AudD sends stream results to","usage":"audd streams callback","runnable":false},{"path":"audd streams callback get","summary":"Show the callback URL","usage":"audd streams callback get","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd streams callback set","summary":"Set the callback URL","usage":"audd streams callback set <url> [flags]","runnable":true,"flags":[{"name":"return","type":"string","usage":"extra metadata in each callback: apple_music, spotify, deezer, musicbrainz (comma-separated)"}],"examples":["audd streams callback set https://example.com/audd-callback --return apple_music,spotify","audd streams callback set https://audd.tech/empty/"],"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd streams export","summary":"Export recorded plays as CSV or JSON lines","usage":"audd streams export [flags]","runnable":true,"flags":[{"name":"id","type":"int","default":"0","usage":"only this stream"},{"name":"since","type":"string","default":"all","usage":"how far back: 24h, 7d, 30d, a date, or \"all\""}],"examples":["audd streams export --since 30d --format csv > plays.csv","audd streams export --since 2026-10-01 --id 1 > plays.jsonl"],"output":"play_stream","streaming":true,"exit_codes":[0,1,2,3,5]},{"path":"audd streams history","summary":"Show recorded plays, newest first","usage":"audd streams history [flags]","runnable":true,"flags":[{"name":"id","type":"int","default":"0","usage":"only this stream"},{"name":"limit","type":"int","default":"50","usage":"at most this many plays (0: all)"},{"name":"since","type":"string","default":"7d","usage":"how far back: 24h, 7d, 2w, a date, or \"all\""}],"examples":["audd streams history","audd streams history --id 1 --since 24h","audd streams history --since 2026-10-01 --limit 0 --format csv > plays.csv"],"output":"plays","exit_codes":[0,1,2,3,5]},{"path":"audd streams list","summary":"List the streams on your account with what played last","usage":"audd streams list","runnable":true,"output":"list","exit_codes":[0,1,2,3,4,5]},{"path":"audd streams record","summary":"Run the stream recorder in the foreground","usage":"audd streams record [<id>...] [flags]","runnable":true,"flags":[{"name":"forward-to","type":"string","usage":"also POST each result to this URL, shaped like an AudD callback"}],"examples":["audd streams record","audd streams record --forward-to http://localhost:3000/audd-callback"],"output":"play_stream","streaming":true,"exit_codes":[0,1,2,3,4,5,6]},{"path":"audd streams recorder","summary":"Start, stop, or check the background stream recorder","usage":"audd streams recorder","runnable":false},{"path":"audd streams recorder start","summary":"Start the background recorder","usage":"audd streams recorder start [flags]","runnable":true,"flags":[{"name":"install-service","type":"bool","usage":"install a login service (systemd user unit, launchd agent, or scheduled task) that starts the recorder when you log in; it prints the command that turns the service on"}],"examples":["audd streams recorder start","audd streams recorder start --install-service"],"output":"object","exit_codes":[0,1,2,3,4,5,6]},{"path":"audd streams recorder status","summary":"Show whether the background recorder runs and what it saved","usage":"audd streams recorder status","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd streams recorder stop","summary":"Stop the background recorder","usage":"audd streams recorder stop","runnable":true,"output":"object","exit_codes":[0,1,2]},{"path":"audd streams remove","aliases":["rm","delete"],"summary":"Stop monitoring a stream","usage":"audd streams remove <id>","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5,6]},{"path":"audd streams report","summary":"Count plays and airtime by song, artist, label, or station","usage":"audd streams report [flags]","runnable":true,"flags":[{"name":"by","type":"string","default":"song","usage":"group by song, artist, label, or station"},{"name":"since","type":"string","default":"30d","usage":"how far back: 24h, 7d, 30d, a date, or \"all\""},{"name":"top","type":"int","default":"0","usage":"only the N rows with the most plays (0: all)"}],"examples":["audd streams report --by artist --since 30d","audd streams report --by song --since 7d --top 20","audd streams report --by station --format csv > stations.csv"],"output":"report","exit_codes":[0,1,2,3,5]},{"path":"audd streams set-url","summary":"Change a stream's URL","usage":"audd streams set-url <id> <url>","runnable":true,"output":"object","exit_codes":[0,1,2,3,4,5]},{"path":"audd streams watch","summary":"Show stream results live","usage":"audd streams watch [<id>...] [flags]","runnable":true,"flags":[{"name":"forward-to","type":"string","usage":"also POST each result to this URL, shaped like an AudD callback"}],"examples":["audd streams watch","audd streams watch 1 2 | jq .","audd streams watch --forward-to http://localhost:3000/audd-callback"],"output":"play_stream","streaming":true,"exit_codes":[0,1,2,3,4,5,6]},{"path":"audd token","summary":"Show, rotate, or re-fetch your API token","usage":"audd token","runnable":false,"examples":["audd token show","audd token show --reveal","audd token rotate","audd token refresh-local"]},{"path":"audd token refresh-local","summary":"Fetch your API token from your account again and save it","usage":"audd token refresh-local","runnable":true,"output":"object","exit_codes":[0,1,2,3,5,6]},{"path":"audd token rotate","summary":"Replace your API token with a new one","usage":"audd token rotate [flags]","runnable":true,"flags":[{"name":"reveal","type":"bool","usage":"print the full new token"}],"examples":["audd token rotate","audd token rotate --yes --reveal"],"output":"object","exit_codes":[0,1,2,3,5,6]},{"path":"audd token show","summary":"Show the API token in use (masked unless --reveal)","usage":"audd token show [flags]","runnable":true,"flags":[{"name":"reveal","type":"bool","usage":"print the full token"}],"output":"object","exit_codes":[0,1,2,3,5,6]},{"path":"audd ui","summary":"Open interactive mode (also: audd with no arguments)","usage":"audd ui [flags]","runnable":true,"flags":[{"name":"section","type":"string","usage":"open this section: recognize, now-playing, streams, history, account, settings, help"}],"examples":["audd ui","audd ui --section streams"],"exit_codes":[0,1,2]},{"path":"audd update","summary":"Update audd to the latest release","usage":"audd update [flags]","runnable":true,"flags":[{"name":"check","type":"bool","usage":"only report whether a newer release is available"}],"examples":["audd update","audd update --check"],"output":"object","exit_codes":[0,1,2,5]},{"path":"audd usage","summary":"Show requests used and remaining this billing cycle","usage":"audd usage [flags]","runnable":true,"flags":[{"name":"check","type":"bool","usage":"exit with code 8 when fewer than --min-remaining requests remain (needs --min-remaining)"},{"name":"days","type":"int","default":"30","usage":"days of per-day history to show"},{"name":"min-remaining","type":"int","default":"0","usage":"with --check, the fewest remaining requests that pass"}],"examples":["audd usage","audd usage --days 7","audd usage --check --min-remaining 1000 --quiet"],"output":"object","exit_codes":[0,1,2,3,5,8]},{"path":"audd version","summary":"Show the audd version","usage":"audd version","runnable":true,"examples":["audd version","audd version --format json"],"output":"object","exit_codes":[0,1,2]},{"path":"audd whoami","alias_of":"audd auth status","summary":"Show the signed-in account and which API token is in use (same as audd auth status)","usage":"audd whoami","runnable":true,"examples":["audd auth status","audd whoami --format json"],"output":"object","exit_codes":[0,1,2,3,5]}],"exit_codes":[{"code":0,"name":"ok","meaning":"success, including no match"},{"code":1,"name":"unexpected","meaning":"unexpected error, or no match with --fail-on-no-match"},{"code":2,"name":"usage","meaning":"invalid arguments or input, or a missing tool such as ffmpeg"},{"code":3,"name":"auth","meaning":"missing or rejected API token, or sign-in needed (audd login)"},{"code":4,"name":"quota","meaning":"quota, plan, or feature not available on the account"},{"code":5,"name":"network","meaning":"network or server error; retrying may help"},{"code":6,"name":"safety","meaning":"a bound is missing (--limit, --max-files), a confirmation is needed (--yes), --max-requests was reached, or an unfinished job for the same files needs --resume or --new"},{"code":7,"name":"partial","meaning":"a batch finished with some files failed"},{"code":8,"name":"threshold","meaning":"usage --check found fewer remaining requests than --min-remaining"},{"code":130,"name":"interrupted","meaning":"stopped with Ctrl-C; a batch keeps finished files (audd jobs resume continues it)"}],"outputs":{"api_response":{"description":"{\"schema_version\":1, ...the fields of the API's JSON response}: the response as AudD sent it, with \"schema_version\" added"},"commands":{"description":"this reference"},"docs":{"description":"The page's markdown as is, piped or not; with --format json, {\"schema_version\":1,\"topic\",\"source\",\"markdown\"}. Without a topic, the list of topics"},"error":{"description":"printed to stderr when a command fails in a machine format","schema":{"properties":{"error":{"properties":{"api_code":{"type":"integer"},"code":{"type":"string"},"hint":{"description":"usually the command that fixes it","type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"}},"type":"object"},"schema_version":{"type":"integer"}},"type":"object"}},"list":{"description":"one JSON document with the rows under \"items\": {\"schema_version\":1,\"items\":[...]}"},"now_playing":{"description":"With --once, one document with the latest song of each stream ({\"stations\":[{\"radio_id\",\"url\",\"stream_running\",\"health\",\"now_playing\":{...play,\"state\",\"playing\",\"elapsed_seconds\",\"played_seconds\",\"ended_at\",\"ago_seconds\",\"length_seconds\"}}]}); otherwise JSON lines, a \"result\" line with the same fields each time the song changes. state is just_played or last_recognized for results sent when a song ends (the default), playing for streams added with --start; elapsed_seconds only while playing, played_seconds and ended_at only for end-of-song results, length_seconds only with provider metadata"},"object":{"description":"one JSON document: {\"schema_version\":1, ...fields}"},"play_stream":{"description":"JSON lines: {\"schema_version\":1,\"type\":\"result\", ...play} per play, and \"event\" lines for stream health","schema":{"properties":{"album":{"type":"string"},"artist":{"type":"string"},"isrc":{"type":"string"},"label":{"type":"string"},"play_length":{"description":"seconds; 0 when unknown","type":"integer"},"radio_id":{"type":"integer"},"release_date":{"type":"string"},"score":{"type":"integer"},"song_link":{"type":"string"},"timestamp":{"format":"date-time","type":"string"},"title":{"type":"string"},"upc":{"type":"string"}},"type":"object"}},"plays":{"description":"{\"schema_version\":1,\"since\",\"plays\":[play...],\"gaps\":[{\"from\",\"to\"}...]}: plays newest first; gaps are periods some stream was not recorded, so totals may miss plays there","schema":{"properties":{"gaps":{"items":{"properties":{"from":{"format":"date-time","type":"string"},"to":{"format":"date-time","type":"string"}},"type":"object"},"type":"array"},"plays":{"items":{"properties":{"album":{"type":"string"},"artist":{"type":"string"},"isrc":{"type":"string"},"label":{"type":"string"},"play_length":{"description":"seconds; 0 when unknown","type":"integer"},"radio_id":{"type":"integer"},"release_date":{"type":"string"},"score":{"type":"integer"},"song_link":{"type":"string"},"timestamp":{"format":"date-time","type":"string"},"title":{"type":"string"},"upc":{"type":"string"}},"type":"object"},"type":"array"}},"type":"object"}},"recognition":{"description":"One file or URL: {\"schema_version\":1,\"input\",\"cached\",\"result\"} where result is AudD's result object or null for no match; with --enterprise, \"matches\" (and \"tracks\" with --tracklist) instead of \"result\"; with --dry-run (one input or a batch), {\"dry_run\":true,\"input\":name|null,\"job_id\":id|null,\"endpoint\":\"standard\"|\"enterprise\",\"plan\":{\"files\",\"cached_files\",\"requests\",\"approximate\",\"cost_usd\"}}: input is set for one file or URL, job_id when a batch would resume a job; requests and cost_usd are null with \"unbounded\":true when enterprise URLs with --limit none (or a dry run without --limit) leave the scan uncapped; with --format jsonl the plan is a \"type\":\"event\" line with \"event\":\"dry_run\". Folders, globs, lists, and jobs resume print JSON lines: \"result\" per file, \"progress\", and a final \"summary\" whose counts are for the whole job (as in audd jobs list), with \"requests_spent_this_run\" for this run.","schema":{"properties":{"cached":{"type":"boolean"},"input":{"type":"string"},"matches":{"description":"enterprise matches, each with start and end positions","type":"array"},"result":{"description":"AudD's result: artist, title, album, release_date, label, timecode, song_link, plus any --return blocks","type":["object","null"]},"schema_version":{"type":"integer"},"tracks":{"description":"with --tracklist: merged tracks with start_seconds and end_seconds","type":"array"}},"type":"object"}},"report":{"description":"{\"schema_version\":1,\"by\",\"since\",\"rows\":[{\"key\",\"plays\",\"airtime_seconds\",\"stations\"}...],\"gaps\",\"complete\"}; complete is false when gaps mean totals miss plays"}}}
